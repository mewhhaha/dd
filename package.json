{
  "name": "dd-workspace",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.8.1+sha512.f64ba907507f5ceafe06c8d38e6052d0179444580ec1279ddd5bfc11cb48aa8a2644b66598e07e761da84872a9fc57d5f902b87fa49d024198d558612aabbe45",
  "scripts": {
    "build:vite-examples": "pnpm --filter './examples/vite-*' build",
    "check:dd-vite-config": "node scripts/check-dd-vite-config.mjs",
    "check:dd-vite-exports": "node scripts/check-dd-vite-exports.mjs",
    "check:dd-vite-lifecycle": "node scripts/check-dd-vite-lifecycle.mjs",
    "check:dd-vite-reload": "node scripts/check-dd-vite-reload.mjs",
    "check:worker-js": "node scripts/check-worker-js.mjs",
    "generate:runtime-types": "node scripts/generate-runtime-types.mjs",
    "browser:vite-examples": "pnpm --filter './examples/vite-react-router' --filter './examples/vite-react-router-rsc' browser",
    "smoke:vite-examples": "pnpm --filter './examples/vite-*' smoke",
    "typecheck:vite-examples": "pnpm --filter './examples/vite-*' typecheck",
    "check:js": "eslint packages/dd-vite/src scripts"
  },
  "devDependencies": {
    "eslint": "^10.11.0",
    "globals": "^17.13.0"
  }
}
